# Copy to backend/.env and fill in. backend/.env is gitignored.

# --- Live mode (both required; demo mode needs neither) ---
GEMINI_API_KEY=
TAVILY_API_KEY=

# --- Models (check https://ai.google.dev/gemini-api/docs/models for current IDs) ---
GEMINI_MODEL=gemini-3.8-flash
# Optional: use a different model for the independent verifier.
VERIFIER_MODEL=

# --- MCP search server (live mode) ---
MCP_SEARCH_COMMAND=npx
MCP_SEARCH_ARGS=-y tavily-mcp@0.2.22

# --- Bounds ---
MAX_ACTIVE_RUNS=2
RUN_TIMEOUT_SECONDS=300
LLM_TIMEOUT_SECONDS=60
TOOL_TIMEOUT_SECONDS=30
MAX_RETRIES=2
MAX_QUERIES_PER_TASK=2
MAX_RESULTS_PER_QUERY=5

# --- Storage / server ---
DB_PATH=data/researchlab.db
CORS_ORIGINS=http://localhost:3000
# Base URL the demo fixture pages are served from (used for demo citations)
DEMO_BASE_URL=http://127.0.0.1:8000
